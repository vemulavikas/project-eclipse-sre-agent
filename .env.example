# Select only one supported provider: nvidia or nebius.
AI_PROVIDER=nvidia
AI_REQUEST_TIMEOUT_SECONDS=60

# Prometheus HTTP API
PROMETHEUS_URL=http://localhost:9090
PROMETHEUS_BEARER_TOKEN=
PROMETHEUS_TIMEOUT_SECONDS=10

# Dashboard server (loopback by default)
HOST=127.0.0.1
PORT=8000

# NVIDIA NIM (OpenAI-compatible chat completions API)
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=

# Nebius Token Factory (OpenAI-compatible chat completions API)
NEBIUS_API_KEY=
NEBIUS_API_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=
